// ============================================================
//  wavewarz.tx  —  txtx deployment runbook
//  Deploy & configure WaveWarz Dynamic NFT on Solana/SVM
//  Uses: txtx CLI, Anchor, Metaplex, Audius oracle
// ============================================================

// ---- INPUTS ------------------------------------------------
input "rpc_url"       { value = env("SOLANA_RPC_URL") }
input "deployer_key"  { value = env("DEPLOYER_KEYPAIR_PATH") }
input "audius_oracle" { value = env("AUDIUS_ORACLE_PUBKEY") }
input "platform_wallet" { value = env("PLATFORM_WALLET_PUBKEY") }
input "platform_fee_bps" { value = 250 }   // 2.5% platform cut

// ---- NETWORK -----------------------------------------------
signer "deployer" "svm::keypair" {
  keypair = input.deployer_key
}

action "deploy_program" "svm::deploy_program" {
  description = "Deploy WaveWarz Dynamic NFT program"
  rpc_api_url = input.rpc_url
  signer      = signer.deployer

  program_id        = "WVWZdynNFT111111111111111111111111111111111"
  artifact_path     = "./target/deploy/wavewarz_dynamic_nft.so"
  idl_path          = "./target/idl/wavewarz_dynamic_nft.json"
  upgrade_authority = signer.deployer
}

// ---- INITIALIZE CONFIG ------------------------------------
action "init_config" "svm::call_contract" {
  description = "Initialize program config PDA"
  rpc_api_url = input.rpc_url
  signer      = signer.deployer
  depends_on  = [action.deploy_program]

  contract_id    = action.deploy_program.program_id
  function_name  = "initialize_config"
  function_args  = [
    input.platform_fee_bps,
    input.audius_oracle,
  ]

  // PDA seeds: ["config"]
  accounts = [
    { name = "config",         is_pda = true, seeds = ["config"] },
    { name = "authority",      signer = signer.deployer },
    { name = "system_program", pubkey = "11111111111111111111111111111111" },
  ]
}

// ---- REGISTER AUDIUS ORACLE --------------------------------
// The oracle is a separate off-chain service that reads the
// Audius API and signs update_stream_data transactions.
// See: audius_oracle.ts for the oracle implementation.
output "audius_oracle_address" {
  value       = input.audius_oracle
  description = "Audius oracle public key registered in config"
}

output "program_id" {
  value       = action.deploy_program.program_id
  description = "Deployed WaveWarz Dynamic NFT program ID"
}

output "config_pda" {
  value       = action.init_config.accounts.config
  description = "Program config PDA address"
}

