# WaveWarz Base Backend Environment Variables

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Blockchain (Base)
BASE_RPC_URL=https://sepolia.base.org
# For mainnet: https://mainnet.base.org

# Smart Contract Addresses (update after deployment)
WAVEWARZ_CONTRACT_ADDRESS=0x...
MUSIC_NFT_CONTRACT=0x...
MARKETPLACE_CONTRACT=0x...
WAVEWARZ_WALLET_ADDRESS=0x...

# Admin Configuration
ADMIN_PRIVATE_KEY=0x...
ADMIN_API_KEY=your-secure-api-key

# SUNO Integration (AI Music Generation)
SUNO_API_URL=https://api.sunoapi.org/v1
SUNO_API_KEY=your-suno-api-key

# ============================================
# CDP (Coinbase Developer Platform) Credentials
# Get from: https://portal.cdp.coinbase.com/
# ============================================
# Supports both CDP_ and COINBASE_ prefixes
# (CDP SDK standard vs OpenClaw/PassFX naming)

# API Key ID (identifies your API key)
CDP_API_KEY_ID=organizations/xxx/apiKeys/xxx
# OR
COINBASE_API_KEY_ID=organizations/xxx/apiKeys/xxx

# API Key Secret (EC private key for signing)
CDP_API_KEY_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n
# OR
COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n

# Wallet Secret (for wallet operations)
CDP_WALLET_SECRET=your-wallet-secret-uuid
# OR
COINBASE_WALLET_SECRET=your-wallet-secret-uuid

# WebSocket Configuration
WS_PING_INTERVAL=30000

# Max Concurrent Battles (default: 1)
MAX_CONCURRENT_BATTLES=1

# ============================================
# Entry-Queue (always-on protocol) Configuration
# v1 model: ~23h open queue (picks = commitments) -> one ~10-min live Quick
# Battle on the existing contract -> settle on trading dominance.
# ============================================
# Battles per cycle (v1 = 1; raise to source more Audius pairs per cycle)
BATTLES_PER_CYCLE=1
# Queue open window in seconds (82800 = 23h; use a small value for testnet dry runs)
QUEUE_WINDOW_SECONDS=82800
# Live Quick Battle duration in seconds (600 = 10 min)
BATTLE_DURATION_SECONDS=600
# Per-actor per-battle budget cap in wei (testnet safety; 0.01 ETH default)
AGENT_MAX_BUDGET_WEI=10000000000000000
# Fee-sink wallets for each side (v1 placeholders; default to WAVEWARZ_WALLET_ADDRESS)
ENTRY_ARTIST_A_WALLET=
ENTRY_ARTIST_B_WALLET=
# Payment token for the battle (empty/zero address = ETH, the testnet default)
ENTRY_PAYMENT_TOKEN=0x0000000000000000000000000000000000000000
# x402 entry fee to place an agent pick, in wei (0.0001 ETH default)
ENTRY_X402_FEE_WEI=100000000000000
# x402 network advertised in 402 responses
X402_NETWORK=base-sepolia
# Audius app_name for catalog reads (no key required)
AUDIUS_APP_NAME=wavewarz
# In-process entry-cycle tick interval in ms (cron can POST /api/entry/tick instead)
ENTRY_TICK_INTERVAL_MS=15000
